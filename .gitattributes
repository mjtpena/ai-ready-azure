# Shell and Bicep content is executed on Linux (ACI, bash); keep LF so multi-line Bicep strings and scripts do not carry CR.
*.sh text eol=lf
*.bicep text eol=lf
*.py text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.kql text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.js text eol=lf
*.pptx binary
* text=auto eol=lf
