# Example GitHub Actions workflow: evaluate the Site Operations Advisor agent on every pull request and block the merge
# when the quality gate fails. Copy to <repo>/.github/workflows/agent-eval.yml to enable.
#
# Auth is federated identity (OIDC) through azure/login: no client secret is stored. Create an Entra app
# registration (or user-assigned managed identity) with a federated credential for
#   repo:<org>/<repo>:pull_request   (and :ref:refs/heads/main for the main branch)
# and grant it on the Foundry project: Foundry User (run the agent, call the judge model, publish evaluation
# results). Store the three ids as repository variables.
#
# Illustrative only: this file is intentionally outside the repository's .github folder.

name: agent-eval

on:
  pull_request:
    paths:
      - "demos/00-shared/**"
      - "demos/03-grounded-foundry-agent/**"
      - "demos/04-trace-and-evaluate/**"
  workflow_dispatch:

permissions:
  id-token: write      # required for OIDC federated login
  contents: read
  pull-requests: write # to post the summary as a comment

concurrency:
  group: agent-eval-${{ github.ref }}
  cancel-in-progress: true

jobs:
  evaluate:
    runs-on: ubuntu-latest
    environment: eval            # protect with required reviewers if the judge model spend matters
    timeout-minutes: 30
    env:
      FOUNDRY_PROJECT_ENDPOINT: ${{ vars.FOUNDRY_PROJECT_ENDPOINT }}
      FOUNDRY_MODEL_NAME: ${{ vars.FOUNDRY_MODEL_NAME }}
      FOUNDRY_EVAL_MODEL_NAME: ${{ vars.FOUNDRY_EVAL_MODEL_NAME }}
      FOUNDRY_AGENT_NAME: hbl-site-ops-advisor
      AI_SEARCH_CONNECTION_ID: ${{ vars.AI_SEARCH_CONNECTION_ID }}
      AI_SEARCH_INDEX: hbl-site-knowledge
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: demos/00-shared/requirements.txt

      - name: Install
        run: pip install -r demos/00-shared/requirements.txt

      - name: Azure login (OIDC, no secrets)
        uses: azure/login@v2
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}

      # Publish this PR's definition as a version of the candidate agent (hbl-site-ops-advisor-candidate); the
      # production agent is untouched and gets the version only when the PR merges.
      - name: Publish candidate agent version
        working-directory: demos/03-grounded-foundry-agent
        run: python 02_create_agent.py --candidate

      - name: Run candidate and evaluate in Foundry
        working-directory: demos/04-trace-and-evaluate
        run: python 02_evaluate.py --agent hbl-site-ops-advisor-candidate --run-agent --out eval/candidate

      - name: Quality gate
        working-directory: demos/04-trace-and-evaluate
        run: python 03_quality_gate.py eval/candidate/results.json

      - name: Upload evaluation artefacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: agent-eval-${{ github.run_number }}
          path: |
            demos/04-trace-and-evaluate/eval/candidate/results.json
            demos/04-trace-and-evaluate/eval/candidate/summary.txt
            demos/04-trace-and-evaluate/eval/candidate/responses.jsonl

      - name: Comment summary on the PR
        if: always() && github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const summary = fs.readFileSync('demos/04-trace-and-evaluate/eval/candidate/summary.txt', 'utf8');
            await github.rest.issues.createComment({
              ...context.repo,
              issue_number: context.issue.number,
              body: `### Site Operations Advisor evaluation\n\n\`\`\`\n${summary}\n\`\`\``,
            });
