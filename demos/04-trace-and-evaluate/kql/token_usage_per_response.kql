// Token usage per model response (gen_ai spans from azure-ai-projects, exported by Azure Monitor OpenTelemetry).
// Run in Application Insights > Logs. The Foundry project's Traces tab uses the same resource.
// Attributes land in customDimensions; the demo's parent span is "hbl.site_ops_advisor.demo".
let window = 1d;
let genai = dependencies
    | where timestamp > ago(window)
    | where isnotempty(customDimensions["gen_ai.usage.input_tokens"])
    | extend
        operation     = tostring(customDimensions["gen_ai.operation.name"]),
        model         = coalesce(tostring(customDimensions["gen_ai.response.model"]), tostring(customDimensions["gen_ai.request.model"])),
        response_id   = tostring(customDimensions["gen_ai.response.id"]),
        input_tokens  = toint(customDimensions["gen_ai.usage.input_tokens"]),
        output_tokens = toint(customDimensions["gen_ai.usage.output_tokens"]);
// Join each model call to the demo's parent span to pick up region and question ids.
let demo = dependencies
    | where timestamp > ago(window) and name == "hbl.site_ops_advisor.demo"
    | project operation_Id, region = tostring(customDimensions["hbl.region"]), question_id = tostring(customDimensions["hbl.question_id"]);
genai
| where name != "hbl.site_ops_advisor.demo"           // the parent span repeats the totals; count model spans only
| join kind=leftouter demo on operation_Id
| project timestamp, question_id, region, operation, model, response_id, input_tokens, output_tokens,
          total_tokens = input_tokens + output_tokens, duration_ms = duration
| order by timestamp desc
