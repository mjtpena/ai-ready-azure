# Copy to .env in demos/00-shared (every module loads it) and fill in. Never commit .env.
# demos/02-identity-policy-ai-gateway/deploy.sh writes this file for you after a deployment.
# Auth is Entra ID via DefaultAzureCredential: run `az login` (or use a managed identity / OIDC in CI).

# Azure context
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=australiaeast
RESOURCE_GROUP=rg-hbl-ops

# Microsoft Foundry project (Overview page of the project in the Foundry portal)
FOUNDRY_ACCOUNT_NAME=aif-hbl-ops-xxxxxxxxxxxxx
FOUNDRY_PROJECT_NAME=proj-hbl-ops
FOUNDRY_PROJECT_ENDPOINT=https://aif-hbl-ops-xxxxxxxxxxxxx.services.ai.azure.com/api/projects/proj-hbl-ops
FOUNDRY_MODEL_NAME=gpt-5-mini
# The evaluation judge (module 4), its own deployment
FOUNDRY_EVAL_MODEL_NAME=gpt-5
FOUNDRY_EMBEDDING_MODEL_NAME=text-embedding-3-small
FOUNDRY_AGENT_NAME=hbl-site-ops-advisor
AZURE_OPENAI_ENDPOINT=https://aif-hbl-ops-xxxxxxxxxxxxx.openai.azure.com

# Azure AI Search (knowledge index). AI_SEARCH_CONNECTION_ID is the Foundry project connection to the search service:
# `project_client.connections.get("<connection name>").id` or copy it from Foundry portal > Management centre > Connected resources.
AI_SEARCH_NAME=srch-hbl-ops-xxxxxxxxxxxxx
AI_SEARCH_ENDPOINT=https://srch-hbl-ops-xxxxxxxxxxxxx.search.windows.net
AI_SEARCH_INDEX=hbl-site-knowledge
AI_SEARCH_CONNECTION_ID=/subscriptions/.../resourceGroups/rg-hbl-ops/providers/Microsoft.CognitiveServices/accounts/aif-hbl-ops-xxxxxxxxxxxxx/projects/proj-hbl-ops/connections/hbl-ops-search
# Embedding dimensions for the index: 1536 for text-embedding-3-small, 3072 for text-embedding-3-large
AI_SEARCH_VECTOR_DIMENSIONS=1536
# Query type the agent's AI Search tool uses: vector_semantic_hybrid (needs the index vectorizer) or simple
AI_SEARCH_QUERY_TYPE=vector_semantic_hybrid

# AI gateway (module 2)
APIM_NAME=apim-hbl-ops-xxxxxxxxxxxxx
APIM_GATEWAY_URL=https://apim-hbl-ops-xxxxxxxxxxxxx.azure-api.net
APIM_SUBSCRIPTION_KEY=

# How the agent reaches its four Site API tools: local (client-executed function tools, the default) or mcp (the API
# Management MCP server at APIM_MCP_URL through the project connection MCP_CONNECTION_NAME).
AGENT_TOOLS=local
APIM_MCP_URL=
MCP_CONNECTION_NAME=

# Tracing. Leave empty to use the Application Insights resource connected to the Foundry project.
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
# Set to true only while recording: it records prompt and response content (may contain personal data) in traces.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Set to `mock` to run any module offline with canned, data-derived responses. Leave empty for live.
DEMO_MODE=
FOUNDRY_PORTAL_PATH=                # the Foundry portal's project path (https://ai.azure.com/nextgen/r/<this>/...), copied from any evaluation link; used by the portal tours
FOUNDRY_REDTEAM_PORTAL_URL=         # the finished red-team run's report link (05_red_team.py --status prints the project page); used by the demo 4 monitor clip
FOUNDRY_EVAL_RUN_URL=            # the production evaluation run's portal link (02_evaluate.py prints it); used by the demo 4 evaluations clip
