<!-- Policy on the REST API site-ops-api: Entra token in, the Functions key (named value) out. Same shape as the models. -->
<policies>
    <inbound>
        <base />
        <validate-azure-ad-token tenant-id="{{tenant-id}}" header-name="Authorization" failed-validation-httpcode="401"
            failed-validation-error-message="Unauthorized. Present an Entra ID bearer token for the Harbourline AI gateway.">
            <audiences>
                <audience>{{entra-audience}}</audience>
            </audiences>
        </validate-azure-ad-token>
        <set-backend-service backend-id="site-api-backend" />
        <set-header name="x-functions-key" exists-action="override">
            <value>{{site-api-key}}</value>
        </set-header>
        <set-header name="api-key" exists-action="delete" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <set-header name="x-hbl-gateway" exists-action="override">
            <value>@("apim/" + context.Deployment.Region)</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
