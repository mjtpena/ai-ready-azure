<!--
  Building block 2: a token budget per site group.
  llm-token-limit (formerly azure-openai-token-limit) counts prompt + completion tokens per counter-key
  and returns HTTP 429 with Retry-After when the per-minute budget is exhausted.
  - counter-key: the x-site-group header if present, otherwise the APIM subscription (team) id.
  - tokens-per-minute comes from the {{tokens-per-minute}} named value (default 500) so it can be tuned in
    the portal without redeploying. 500 TPM trips on the 3rd or 4th advisor question - deliberately small.
  - estimate-prompt-tokens="true": reject BEFORE calling the model when the estimate already exceeds the budget.
  - remaining-tokens-header-name / tokens-consumed-header-name: visible in every response, which is what the
    client prints.
  Not available on the Consumption tier; Basicv2 / Standardv2 / classic tiers are fine.
-->
<policies>
    <inbound>
        <base />
        <set-variable name="siteGroup" value="@(context.Request.Headers.GetValueOrDefault("x-site-group", context.Subscription?.Id ?? "anonymous"))" />
        <llm-token-limit counter-key="@((string)context.Variables["siteGroup"])"
            tokens-per-minute="{{tokens-per-minute}}"
            estimate-prompt-tokens="true"
            remaining-tokens-header-name="x-remaining-tokens"
            remaining-tokens-variable-name="remainingTokens"
            tokens-consumed-header-name="x-consumed-tokens"
            retry-after-header-name="Retry-After" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
